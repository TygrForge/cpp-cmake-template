{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch App (CMake)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Launch App (CMake + LLDB)",
            "type": "lldb",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
        },
        {
            "name": "Launch App (GDB)",
            "type": "gdb",
            "request": "launch",
            "target": "${command:cmake.launchTargetPath}",
            "arguments": "",
            "cwd": "${workspaceFolder}",
            "valuesFormatting": "parseText"
        },
        {
            "name": "Launch App (Mago-MI)",
            "type": "mago-mi",
            "request": "launch",
            "target": "${command:cmake.launchTargetPath}",
            "cwd": "${workspaceFolder}"
        }
    ]
}